<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campgrounds</title>
</head>

<body>
    <h1>All Campgrounds</h1>
    <ul>
        <% for(let c of campground){ %>
            <li>
                <a href="/campgrounds/<%= c.id %>">
                    <%= c.title %>
                </a>
            </li>
            <% } %>
    </ul>
    <footer>
        <a href="/campgrounds/new">Add Campground</a>
    </footer>
</body>

</html>